# Rink Tracker — environment configuration
# Copy to .env (gitignored) and fill in real values.

# ADMIN_PINS — predetermined admin accounts seeded into the users table at boot.
# Format: name:pin,name:pin   (PINs are bcrypt-hashed before storage)
# Names case-insensitive. Rotate by changing here and restarting.
# Example: ADMIN_PINS=jay:4830,marc:7194
ADMIN_PINS=
