# Rink Tracker — environment configuration
# Copy to .env (gitignored) and fill in real values.

# RINK_ADMIN_PINS — predetermined admin accounts seeded into `members` at boot.
# (Renamed from ADMIN_PINS in the rebuild — the old name is not read.)
# Format: name:pin,name:pin
# Admin gates severity, delete and settings ONLY. Member writes never need it.
# Example: RINK_ADMIN_PINS=jay:4830,marc:7194
RINK_ADMIN_PINS=

# Optional — all have working defaults, see README.
# RINK_DB=data/rink.db
# RINK_SESSION_SECRET=            # auto-generated and persisted if unset
# RINK_SCHEDULE_URL=
# RINK_LAT=41.8
# RINK_LON=-73.12
# RINK_CRON_HOUR=7
# RINK_DISABLE_CRON=1             # set to disable the in-process morning job

# NOT an env var: BUILD_SHA is a Docker BUILD ARG. See docs/deploy.md.
